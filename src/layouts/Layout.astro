---
interface Props { title: string; }
const { title } = Astro.props;
---
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="description" content="Louis Huy Nguyen — Software Architect and senior backend/cloud engineer building scalable systems with Go, Kubernetes, Azure, AWS, and observability." />
  <meta property="og:title" content={title} />
  <meta property="og:description" content="Software Architect with 8+ years designing reliable cloud, backend, and platform systems." />
  <meta property="og:type" content="website" />
  <title>{title}</title>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Instrument+Sans:wght@400;500;600;700;800&family=Space+Grotesk:wght@500;600;700&family=IBM+Plex+Mono:wght@500;600;700&family=Pixelify+Sans:wght@600;700&display=swap" rel="stylesheet" />
</head>
<body>
  <slot />
</body>
</html>
