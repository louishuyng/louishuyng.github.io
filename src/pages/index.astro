---
import Layout from '../layouts/Layout.astro';
import Icon from '../components/Icon.astro';
import { Image } from 'astro:assets';
import shotRegask from '../assets/projects/regask-site.png';
import shotPerx from '../assets/projects/perxtech-site.png';
import shotSakani from '../assets/projects/sakani-site.png';
import shotKomi from '../assets/projects/komi-site.png';
import shotUob from '../assets/projects/uob-site.png';
import shotPine from '../assets/projects/productpine-site.png';
import '../styles/global.css';

const experiences = [
  {
    role: 'Solution Architect',
    company: 'Regask',
    period: 'Jul 2025 — Present',
    stack: 'Go · Kubernetes · Knative · Azure · Temporal · Redis · Crossplane',
    bullets: [
      'Redesigned high-traffic services around Knative and event-driven patterns on Kubernetes, increasing throughput by 40% and reducing infrastructure costs by 30%.',
      'Implemented Redis write-behind caching, scaling per-service write throughput from 10K to 100K requests per second while reducing database load.',
      'Building the authorization server connecting the application suite to Claude through MCP, with scoped, per-user access to internal services.',
      'Introduced Temporal durable execution and event orchestration for the AI workflow builder, allowing multi-step agent flows to resume after restarts.',
      'Instrumented all microservices with Grafana Cloud, establishing performance baselines, SLOs, and anomaly alerts.',
      'Built a local service-mesh simulator that reduced high-priority issue resolution time by 20%, and rolled out Backstage to unify the service catalogue, development workflow, and releases.',
      'Led Terraform adoption and consolidated Kafka, database, and supporting infrastructure provisioning under Kubernetes with Crossplane.',
    ],
  },
  {
    role: 'Senior Software Engineer',
    company: 'Regask',
    period: 'Feb 2024 — Jul 2025',
    stack: 'Go · Node.js · Azure · Okta · SAML · OIDC',
    bullets: [
      'Architected a highly available Azure platform with redundancy and failover across every critical component.',
      'Rewrote memory-bound Node.js services in Go, reducing memory per service from 1.5 GB to 400–500 MB.',
      'Delivered enterprise SSO with Okta across SAML and OIDC, unifying authentication between services.',
      'Introduced Technical Solution Documents and structured code reviews for 5–7 engineers, shortening review cycles and reducing production bugs.',
    ],
  },
  {
    role: 'Senior Software Engineer',
    company: 'PerxTech',
    period: 'Jan 2022 — Sep 2023',
    stack: 'Ruby · Traefik · Kafka · AWS Step Functions · ETL',
    bullets: [
      'Architected Ruby services sustaining 10K requests per second at peak without additional infrastructure.',
      'Built a banking-data ETL pipeline, reducing import time from 5 hours to 15 minutes per GB and lowering cloud transfer spend.',
      'Built an API gateway with Traefik for centralized routing, load balancing, and access control.',
      'Led a cross-functional team of five engineers and orchestrated Kafka event workflows with AWS Step Functions.',
    ],
  },
  {
    role: 'Backend Engineer (Consultant)',
    company: 'ProductPine',
    period: 'Jan 2022 — Dec 2022',
    stack: 'Shopify · E-commerce · Webhooks · Data Pipelines',
    bullets: [
      'Designed the backend pipeline integrating Shopify with the e-commerce application and built a reconciliation service to detect and correct data drift.',
      'Made two-way sync idempotent, deduplicating webhook deliveries so retries and concurrent updates could not create duplicate orders.',
      'Owned core e-commerce domain services, deployments, and pipeline monitoring to catch sync failures before they reached customers.',
    ],
  },
  {
    role: 'Full Stack Software Engineer',
    company: 'Oivan',
    period: 'Jan 2021 — Jan 2022',
    stack: 'Angular · Go · Ruby · gRPC',
    bullets: [
      'Led a frontend team of 2–3 engineers on a Saudi real estate platform and documented its critical microservice flows.',
      'Optimized complex queries, reducing request latency from 3 seconds to 500 ms, and introduced gRPC for internal service communication.',
      'Raised code quality across Angular, Go, and Ruby through structured testing and review.',
    ],
  },
  {
    role: 'Full Stack Software Engineer',
    company: 'Nucleus Studio',
    period: 'Jan 2020 — Jan 2021',
    stack: 'React Native · NestJS · WebRTC · Firebase · GCP · AWS · Stripe',
    bullets: [
      'Built hybrid mobile applications with React Native and NestJS, including livestream and video call features over WebRTC.',
      'Integrated Firebase, GCP, and AWS services, and implemented Stripe payment processing.',
    ],
  },
  {
    role: 'Platform Developer',
    company: 'Aleph Labs',
    period: 'Jan 2018 — Jan 2020',
    stack: 'Frontend Components · SDK · Microservices · Authentication APIs',
    bullets: [
      'Built reusable frontend components and a microservices SDK adopted across multiple product teams.',
      'Designed and implemented authentication APIs, strengthening platform security.',
    ],
  },
];

const skills = [
  ['code', 'Languages', 'Go, Ruby, TypeScript, JavaScript'],
  ['cloud', 'Cloud & Infrastructure', 'Azure, AWS, GCP, Kubernetes, Knative, Crossplane, Terraform'],
  ['layers', 'Architecture', 'Microservices, Event-driven Architecture, Temporal, API Design, gRPC, Data Pipelines'],
  ['server', 'Platform & Operations', 'Kafka, Redis, Traefik, Backstage, DevOps'],
  ['activity', 'Observability', 'Grafana Cloud, Performance Baselines, SLOs, Anomaly Alerts'],
  ['shield', 'Security', 'SSO, Okta, SAML, OIDC, Scoped MCP Access'],
];

const projects = [
  {
    name: 'Regask Platform',
    company: 'Regask',
    href: 'https://regask.com',
    summary: 'AI regulatory intelligence platform. Scope included cloud architecture, Kubernetes/Knative services, observability, Okta SSO, scoped MCP access, and durable AI workflows with Temporal.',
    tags: ['Go', 'Kubernetes', 'Temporal', 'MCP', 'Azure'],
  },
  {
    name: 'PerxTech Platform',
    company: 'PerxTech',
    href: 'https://perxtech.com',
    summary: 'Loyalty and customer engagement platform. Scope included Ruby service optimization, API gateway architecture, PostgreSQL performance, and ETL pipelines.',
    tags: ['Ruby', 'Traefik', 'Kafka', 'AWS', 'ETL'],
  },
  {
    name: 'Sakani Platform',
    company: 'Oivan',
    href: 'https://oivan.com/our-work/nhci-sakani-platform/',
    summary: 'National housing platform by NHC. Scope included full-stack engineering, frontend delivery, backend integration, and performance improvements.',
    tags: ['Angular', 'Go', 'Ruby', 'gRPC'],
  },
  {
    name: 'Komi',
    company: 'Nucleus Studio',
    href: 'https://komi.io/',
    summary: 'Creator commerce and mobile-first product experience. Scope included React Native and NestJS features with Firebase, GCP, and AWS integrations.',
    tags: ['React Native', 'NestJS', 'Firebase', 'GCP'],
  },
  {
    name: 'UOB Bank Platform',
    company: 'Aleph Labs',
    href: 'https://www.uobgroup.com/',
    summary: 'Banking platform engineering. Scope included secure authentication APIs, reusable frontend components, and shared SDK microservices for multiple teams.',
    tags: ['Node.js', 'React', 'Auth APIs', 'Microservices'],
  },
  {
    name: 'ProductPine',
    company: 'ProductPine',
    href: 'https://productpine.com/en-NL',
    summary: 'E-commerce platform. Scope included Shopify integration, automatic data reconciliation, idempotent two-way sync, core domain services, and pipeline monitoring.',
    tags: ['Shopify', 'Webhooks', 'Data Pipelines', 'E-commerce'],
  },
];

const shots: Record<string, ImageMetadata> = { 'Regask Platform': shotRegask, 'PerxTech Platform': shotPerx, 'Sakani Platform': shotSakani, 'Komi': shotKomi, 'UOB Bank Platform': shotUob, 'ProductPine': shotPine };

const logos: Record<string, string> = { Regask: '/companies/regask.svg', PerxTech: '/companies/perxtech.png', Oivan: '/companies/oivan.png', 'Nucleus Studio': '/companies/komi.svg', ProductPine: '/companies/productpine.svg', 'Aleph Labs': '/companies/aleph.png' };
const stackChips = ['Go', 'TypeScript', 'Ruby', 'Kubernetes', 'Knative', 'Temporal', 'Kafka', 'Redis', 'Azure', 'AWS', 'GCP', 'Terraform', 'Crossplane', 'Grafana', 'Okta', 'gRPC', 'Traefik', 'Backstage'];
const yearOf = (company: string) => (experiences.find((j) => j.company === company)?.period.match(/\d{4}/) ?? [''])[0];

const links = [
  { icon: 'mail', label: 'Email', href: 'mailto:huynguyennbk@gmail.com' },
  { icon: 'linkedin', label: 'LinkedIn', href: 'https://www.linkedin.com/in/louishuyng/' },
  { icon: 'github', label: 'GitHub', href: 'https://github.com/louishuyng' },
  { icon: 'award', label: 'Claude Code in Action', href: 'https://verify.skilljar.com/c/jfnifed5mprf' },
  { icon: 'award', label: 'Certificates', href: 'https://www.credly.com/users/nguyen-louis/badges#credly' },
];
---

<Layout title="Louis Huy Nguyen — Solution Architect">
  <a class="skip-link" href="#main">Skip to content</a>
  <div class="glow" aria-hidden="true"></div>
  <div class="cursor" aria-hidden="true"></div>

  <aside class="side side-l" aria-label="Status">
    <div><small>Local time</small><span><time data-clock>--:--</time> ICT</span></div>
    <div><small>Availability</small><span><i class="dot"></i> Open to opportunities</span></div>
    <div class="side-bottom"><small>Based in</small><span>Ho Chi Minh City, Vietnam</span><small class="coords">10.7769° N · 106.7009° E</small></div>
  </aside>

  <aside class="side side-r" aria-label="Links">
    <div><button id="theme-toggle" class="side-btn" type="button" aria-label="Toggle theme" aria-pressed="false" hidden>Theme <Icon name="sun" size={12} class="icon-sun" /><Icon name="moon" size={12} class="icon-moon" /></button></div>
    <div><small>Follow me</small>
      <a href="https://github.com/louishuyng" target="_blank" rel="noopener">GitHub <Icon name="arrow-up-right" size={11} /></a>
      <a href="https://www.linkedin.com/in/louishuyng/" target="_blank" rel="noopener">LinkedIn <Icon name="arrow-up-right" size={11} /></a>
      <a href="https://www.raycast.com/louishuyng" target="_blank" rel="noopener">Raycast <Icon name="arrow-up-right" size={11} /></a>
      <a href="https://www.credly.com/users/nguyen-louis/badges#credly" target="_blank" rel="noopener">Credly <Icon name="arrow-up-right" size={11} /></a>
    </div>
  </aside>

  <main id="main" class="col">
    <header id="top" class="intro">
      <p class="meta-row"><span><i class="dot"></i> Open to opportunities</span><span><time data-clock>--:--</time> ICT · Vietnam</span><button id="theme-toggle-m" class="side-btn" type="button" aria-label="Toggle theme">Theme <Icon name="sun" size={12} class="icon-sun" /><Icon name="moon" size={12} class="icon-moon" /></button></p>
      <h1>Louis Huy Nguyen</h1>
      <p class="bio">I’m a <strong>Solution Architect</strong> at <a class="co" href="https://regask.com" target="_blank" rel="noopener"><img src="/companies/regask.svg" alt="" height="11" />Regask</a>, with 8+ years building <strong>event-driven platforms</strong> on Kubernetes, Azure and AWS. My focus is backend architecture, observability and infrastructure-as-code: systems that stay fast and stay up.</p>
      <p class="actions"><a href="mailto:huynguyennbk@gmail.com">Email <Icon name="arrow-up-right" size={11} /></a><a href="/cv.pdf" download="Louis_Nguyen_Software_Engineer.pdf">Résumé <Icon name="download" size={11} /></a><a href="/cover-letter.pdf" download="Louis_Huy_Nguyen_Cover_Letter.pdf">Cover letter <Icon name="download" size={11} /></a></p>
    </header>

    <section id="projects" class="sec">
      <h2>Projects <a href="#all-projects">View all</a></h2>
      <div class="carousel" aria-label="Project screenshots. Click to see the next one.">
        {projects.filter((p) => shots[p.name]).map((project, i) => (
          <figure class="slide">
            <Image src={shots[project.name]} width={1040} alt={`${project.name} website`} loading={i === 0 ? 'eager' : 'lazy'} draggable="false" />
            <span class="slide-tag">{project.company}</span>
            <figcaption class="slide-cap"><strong>{project.name}</strong><span>{project.summary.split('. ')[0]}.</span><a href={project.href} target="_blank" rel="noopener">Visit <Icon name="arrow-up-right" size={11} /></a></figcaption>
          </figure>
        ))}
      </div>
      <div class="dots" role="tablist" aria-label="Choose project">{projects.filter((p) => shots[p.name]).map((p, i) => <button type="button" role="tab" aria-label={p.name} aria-selected={i === 0 ? "true" : "false"}></button>)}</div>
    </section>

    <section id="experience" class="sec">
      <h2>Experience</h2>
      <ol class="rows">
        {experiences.map((job) => (
          <li>
            <details>
              <summary><span class="r-co">{job.company}</span><span class="r-role">{job.role}</span><span class="r-lead" aria-hidden="true"></span><span class="r-year">{job.period.includes('Present') ? 'Present' : job.period.slice(-4)}</span></summary>
              <div class="r-body"><div><p class="r-stack">{job.stack}</p><ul>{job.bullets.map((b) => <li>{b}</li>)}</ul></div></div>
            </details>
          </li>
        ))}
      </ol>
    </section>

    <section class="sec">
      <h2>Highlights</h2>
      <ol class="hl">
        <li><span>10×</span><p>Write throughput, 10K to 100K requests per second, with Redis write-behind caching at Regask.</p></li>
        <li><span>30%</span><p>Lower infrastructure cost after moving services to Knative on Kubernetes.</p></li>
        <li><span>20×</span><p>Faster banking-data ETL at PerxTech, 5 hours down to 15 minutes per GB.</p></li>
        <li><span>3.5×</span><p>Less memory per service after rewriting Node.js services in Go, 1.5 GB to 400 MB.</p></li>
      </ol>
    </section>

    <section id="expertise" class="sec two">
      <div><h2>Now</h2>
        <ul class="now-list">
          <li><Icon name="layers" size={13} /> Architecting the Regask platform for the AI era: durable agent workflows on Temporal, scoped access to internal systems through MCP, and the cloud foundation they run on.</li>
          <li><Icon name="user" size={13} /> Leading the engineering team through that shift: design reviews, technical solution documents, and a shared service catalogue so decisions outlive the people who made them.</li>
          <li><Icon name="sparkles" size={13} /> Working AI into how we build, not just what we build: AI-assisted delivery with clear guardrails, measured against real outcomes.</li>
        </ul>
        <p class="now-sub">Also contributing to Raycast and Neovim.</p></div>
      <div><h2>Stack</h2><p class="stack-row">{stackChips.map((c) => <span>{c}</span>)}</p></div>
    </section>

    <section id="all-projects" class="sec">
      <h2>All projects</h2>
      <ol class="rows">
        {projects.map((project) => (
          <li><a class="row-link" href={project.href} target="_blank" rel="noopener"><span class="r-co">{project.name}</span><span class="r-role">{project.tags.slice(0, 3).join(' · ')}</span><span class="r-lead" aria-hidden="true"></span><span class="r-year">{yearOf(project.company)}</span></a></li>
        ))}
      </ol>
    </section>

    <canvas class="dotgrid" aria-hidden="true"></canvas>

    <footer id="contact" class="foot">
      <div><small>Contact</small><p>Have a system that needs to hold up? Reach out by email or LinkedIn.</p><a class="mail" href="mailto:huynguyennbk@gmail.com">huynguyennbk@gmail.com</a></div>
      <div><small>Elsewhere</small>{links.map((l) => <a href={l.href} target={l.href.startsWith('http') ? '_blank' : undefined} rel="noopener">{l.label} <Icon name="arrow-up-right" size={11} /></a>)}</div>
      <p class="copy">© {new Date().getFullYear()} Louis Huy Nguyen</p>
    </footer>
  </main>

  <nav class="dock" aria-label="Sections">
    <a href="#top">Home</a><a href="#projects">Projects</a><a href="#experience">Experience</a><a href="#expertise">Stack</a><a href="#contact">Contact</a>
  </nav>

  <script>
    const fmt = new Intl.DateTimeFormat('en-GB', { timeZone: 'Asia/Ho_Chi_Minh', hour: '2-digit', minute: '2-digit' });
    const clocks = document.querySelectorAll('[data-clock]');
    const tick = () => clocks.forEach((c) => (c.textContent = fmt.format(new Date())));
    tick(); setInterval(tick, 15000);

    // Mobile theme button mirrors the sidebar one (Layout.astro owns the toggle logic).
    document.getElementById('theme-toggle-m')?.addEventListener('click', () => document.getElementById('theme-toggle')?.click());

    // Carousel: click a slide (or a dot) to advance; no drag.
    const track = document.querySelector<HTMLElement>('.carousel');
    const dots = [...document.querySelectorAll<HTMLButtonElement>('.dots button')];
    if (track) {
      const slides = [...track.children] as HTMLElement[];
      let current = 0;
      const go = (i: number) => {
        current = (i + slides.length) % slides.length;
        track.scrollTo({ left: slides[current].offsetLeft - track.offsetLeft, behavior: 'smooth' });
        dots.forEach((d, j) => d.setAttribute('aria-selected', String(j === current)));
      };
      slides.forEach((sl, i) => sl.addEventListener('click', (e) => { if ((e.target as HTMLElement).closest('a')) return; go(i === current ? current + 1 : i); }));
      dots.forEach((d, i) => d.addEventListener('click', () => go(i)));
      track.addEventListener('keydown', (e) => { if (e.key === 'ArrowRight') go(current + 1); if (e.key === 'ArrowLeft') go(current - 1); });
    }

    // Custom cursor + reactive dot grid, fine pointers only.
    const fine = matchMedia('(pointer: fine)').matches && !matchMedia('(prefers-reduced-motion: reduce)').matches;
    const cur = document.querySelector<HTMLElement>('.cursor');
    const grid = document.querySelector<HTMLCanvasElement>('.dotgrid');
    let mx = -100, my = -100;
    if (fine && cur) {
      document.documentElement.classList.add('has-cursor');
      let cx = mx, cy = my;
      window.addEventListener('pointermove', (e) => { mx = e.clientX; my = e.clientY; cur.classList.add('show'); });
      document.addEventListener('pointerleave', () => cur.classList.remove('show'));
      document.addEventListener('pointerover', (e) => cur.classList.toggle('big', !!(e.target as HTMLElement).closest('a, button, summary, .slide')));
      const loop = () => { cx += (mx - cx) * .25; cy += (my - cy) * .25; cur.style.transform = `translate(${cx}px, ${cy}px) translate(-50%, -50%)`; requestAnimationFrame(loop); };
      loop();
    }
    if (grid) {
      const ctx = grid.getContext('2d')!;
      const draw = () => {
        const r = grid.getBoundingClientRect(), dpr = devicePixelRatio || 1;
        if (grid.width !== Math.round(r.width * dpr)) { grid.width = Math.round(r.width * dpr); grid.height = Math.round(r.height * dpr); }
        ctx.setTransform(dpr, 0, 0, dpr, 0, 0); ctx.clearRect(0, 0, r.width, r.height);
        const cs = getComputedStyle(document.documentElement);
        const base = cs.getPropertyValue('--line-dot').trim(), hot = cs.getPropertyValue('--accent-2').trim();
        const gap = 14, lx = mx - r.left, ly = my - r.top;
        for (let y = gap / 2; y < r.height; y += gap) for (let x = gap / 2; x < r.width; x += gap) {
          const d = Math.hypot(x - lx, y - ly), t = fine ? Math.max(0, 1 - d / 110) : 0;
          ctx.fillStyle = t > .08 ? hot : base; ctx.globalAlpha = t > .08 ? .35 + t * .65 : 1;
          ctx.beginPath(); ctx.arc(x, y, 1.2 + t * 2.2, 0, Math.PI * 2); ctx.fill();
        }
        ctx.globalAlpha = 1;
        if (fine) requestAnimationFrame(draw);
      };
      draw();
      new ResizeObserver(draw).observe(grid);
    }

    const navLinks = [...document.querySelectorAll<HTMLAnchorElement>('.dock a')];
    const targets = navLinks.map((a) => document.querySelector<HTMLElement>(a.hash)).filter(Boolean) as HTMLElement[];
    const spy = new IntersectionObserver((es) => es.forEach((e) => { if (e.isIntersecting) navLinks.forEach((a) => a.classList.toggle('active', a.hash === `#${e.target.id}`)); }), { rootMargin: '-35% 0px -55%' });
    targets.forEach((t) => spy.observe(t));
  </script>
</Layout>
