---
import Layout from '../layouts/Layout.astro';
import '../styles/global.css';

const experiences = [
  {
    role: 'Solution Architect',
    company: 'Regask',
    period: 'Jul 2025 — Present',
    stack: 'Go · Kubernetes · Knative · Azure · Temporal · Redis · Crossplane',
    bullets: [
      'Redesigned high-traffic services around Knative and event-driven patterns on Kubernetes, increasing throughput by 40% and reducing infrastructure costs by 30%.',
      'Implemented Redis write-behind caching, scaling per-service write throughput from 10K to 100K requests per second while reducing database load.',
      'Building the authorization server connecting the application suite to Claude through MCP, with scoped, per-user access to internal services.',
      'Introduced Temporal durable execution and event orchestration for the AI workflow builder, allowing multi-step agent flows to resume after restarts.',
      'Instrumented all microservices with Grafana Cloud, establishing performance baselines, SLOs, and anomaly alerts.',
      'Built a local service-mesh simulator that reduced high-priority issue resolution time by 20%, and rolled out Backstage to unify the service catalogue, development workflow, and releases.',
      'Led Terraform adoption and consolidated Kafka, database, and supporting infrastructure provisioning under Kubernetes with Crossplane.',
    ],
  },
  {
    role: 'Senior Software Engineer',
    company: 'Regask',
    period: 'Feb 2024 — Jul 2025',
    stack: 'Go · Node.js · Azure · Okta · SAML · OIDC',
    bullets: [
      'Architected a highly available Azure platform with redundancy and failover across every critical component.',
      'Rewrote memory-bound Node.js services in Go, reducing memory per service from 1.5 GB to 400–500 MB.',
      'Delivered enterprise SSO with Okta across SAML and OIDC, unifying authentication between services.',
      'Introduced Technical Solution Documents and structured code reviews for 5–7 engineers, shortening review cycles and reducing production bugs.',
    ],
  },
  {
    role: 'Senior Software Engineer',
    company: 'PerxTech',
    period: 'Jan 2022 — Sep 2023',
    stack: 'Ruby · Traefik · Kafka · AWS Step Functions · ETL',
    bullets: [
      'Architected Ruby services sustaining 10K requests per second at peak without additional infrastructure.',
      'Built a banking-data ETL pipeline, reducing import time from 5 hours to 15 minutes per GB and lowering cloud transfer spend.',
      'Built an API gateway with Traefik for centralized routing, load balancing, and access control.',
      'Led a cross-functional team of five engineers and orchestrated Kafka event workflows with AWS Step Functions.',
    ],
  },
  {
    role: 'Backend Engineer (Consultant)',
    company: 'ProductPine',
    period: 'Jan 2022 — Dec 2022',
    stack: 'Shopify · E-commerce · Webhooks · Data Pipelines',
    bullets: [
      'Designed the backend pipeline integrating Shopify with the e-commerce application and built a reconciliation service to detect and correct data drift.',
      'Made two-way sync idempotent, deduplicating webhook deliveries so retries and concurrent updates could not create duplicate orders.',
      'Owned core e-commerce domain services, deployments, and pipeline monitoring to catch sync failures before they reached customers.',
    ],
  },
  {
    role: 'Full Stack Software Engineer',
    company: 'Oivan',
    period: 'Jan 2021 — Jan 2022',
    stack: 'Angular · Go · Ruby · gRPC',
    bullets: [
      'Led a frontend team of 2–3 engineers on a Saudi real estate platform and documented its critical microservice flows.',
      'Optimized complex queries, reducing request latency from 3 seconds to 500 ms, and introduced gRPC for internal service communication.',
      'Raised code quality across Angular, Go, and Ruby through structured testing and review.',
    ],
  },
  {
    role: 'Full Stack Software Engineer',
    company: 'Nucleus Studio',
    period: 'Jan 2020 — Jan 2021',
    stack: 'React Native · NestJS · WebRTC · Firebase · GCP · AWS · Stripe',
    bullets: [
      'Built hybrid mobile applications with React Native and NestJS, including livestream and video call features over WebRTC.',
      'Integrated Firebase, GCP, and AWS services, and implemented Stripe payment processing.',
    ],
  },
  {
    role: 'Platform Developer',
    company: 'Aleph Labs',
    period: 'Jan 2018 — Jan 2020',
    stack: 'Frontend Components · SDK · Microservices · Authentication APIs',
    bullets: [
      'Built reusable frontend components and a microservices SDK adopted across multiple product teams.',
      'Designed and implemented authentication APIs, strengthening platform security.',
    ],
  },
];

const skills = [
  ['Languages', 'Go, Ruby, TypeScript, JavaScript'],
  ['Cloud & Infrastructure', 'Azure, AWS, GCP, Kubernetes, Knative, Crossplane, Terraform'],
  ['Architecture', 'Microservices, Event-driven Architecture, Temporal, API Design, gRPC, Data Pipelines'],
  ['Platform & Operations', 'Kafka, Redis, Traefik, Backstage, DevOps'],
  ['Observability', 'Grafana Cloud, Performance Baselines, SLOs, Anomaly Alerts'],
  ['Security', 'SSO, Okta, SAML, OIDC, Scoped MCP Access'],
];

const projects = [
  {
    name: 'Regask Platform',
    company: 'Regask',
    href: 'https://regask.com',
    summary: 'AI regulatory intelligence platform. Scope included cloud architecture, Kubernetes/Knative services, observability, Okta SSO, scoped MCP access, and durable AI workflows with Temporal.',
    tags: ['Go', 'Kubernetes', 'Temporal', 'MCP', 'Azure'],
  },
  {
    name: 'PerxTech Platform',
    company: 'PerxTech',
    href: 'https://perxtech.com',
    summary: 'Loyalty and customer engagement platform. Scope included Ruby service optimization, API gateway architecture, PostgreSQL performance, and ETL pipelines.',
    tags: ['Ruby', 'Traefik', 'Kafka', 'AWS', 'ETL'],
  },
  {
    name: 'Sakani Platform',
    company: 'Oivan',
    href: 'https://oivan.com/our-work/nhci-sakani-platform/',
    summary: 'National housing platform by NHC. Scope included full-stack engineering, frontend delivery, backend integration, and performance improvements.',
    tags: ['Angular', 'Go', 'Ruby', 'gRPC'],
  },
  {
    name: 'Komi',
    company: 'Nucleus Studio',
    href: 'https://komi.io/',
    summary: 'Creator commerce and mobile-first product experience. Scope included React Native and NestJS features with Firebase, GCP, and AWS integrations.',
    tags: ['React Native', 'NestJS', 'Firebase', 'GCP'],
  },
  {
    name: 'UOB Bank Platform',
    company: 'Aleph Labs',
    href: 'https://www.uobgroup.com/',
    summary: 'Banking platform engineering. Scope included secure authentication APIs, reusable frontend components, and shared SDK microservices for multiple teams.',
    tags: ['Node.js', 'React', 'Auth APIs', 'Microservices'],
  },
  {
    name: 'ProductPine',
    company: 'ProductPine',
    href: 'https://productpine.com/en-NL',
    summary: 'E-commerce platform. Scope included Shopify integration, automatic data reconciliation, idempotent two-way sync, core domain services, and pipeline monitoring.',
    tags: ['Shopify', 'Webhooks', 'Data Pipelines', 'E-commerce'],
  },
];

const links = [
  { label: 'Email', href: 'mailto:huynguyennbk@gmail.com' },
  { label: 'LinkedIn', href: 'https://www.linkedin.com/in/louishuyng/' },
  { label: 'GitHub', href: 'https://github.com/louishuyng' },
  { label: 'Claude Code in Action', href: 'https://verify.skilljar.com/c/jfnifed5mprf' },
  { label: 'Certificates', href: 'https://www.credly.com/users/nguyen-louis/badges#credly' },
];
---

<Layout title="Louis Huy Nguyen — Solution Architect / Senior Software Engineer">
  <a class="skip-link" href="#main">Skip to content</a>
  <div class="site-shell" id="top">
    <header class="nav">
      <a class="brand" href="#top" aria-label="Louis Huy Nguyen home"><span class="brand-mark" aria-hidden="true">l.</span> louis nguyen<span class="brand-dot">®</span></a>
      <nav class="nav-links" aria-label="Main navigation">
        <a href="#projects">Work</a><a href="#experience">Experience</a><a href="#skills">Expertise</a>
      </nav>
      <div class="nav-actions">
        <button id="theme-toggle" class="theme-toggle" type="button" aria-label="Dark mode" aria-pressed="false" hidden>
          <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="M20.5 13A8.5 8.5 0 0 1 11 3.5 8.5 8.5 0 1 0 20.5 13Z" /></svg>
        </button>
        <a class="nav-cta" href="#contact">Let’s talk <span aria-hidden="true">↗</span></a>
      </div>
    </header>

    <main id="main">
      <section class="hero" aria-labelledby="hero-title">
        <div class="hero-copy">
          <p class="eyebrow"><span class="status-dot"></span> Available for the right opportunity</p>
          <h1 id="hero-title">Complex systems.<br /><span>Clear thinking.</span></h1>
          <p class="hero-intro">I’m Louis, a solution architect.<br />I turn ambitious ideas into systems that hold up.</p>
          <p class="hero-text">I build scalable, event-driven systems on Kubernetes, Azure, and AWS, with a focus on backend architecture, observability, and infrastructure-as-code. I also contribute to Raycast and Neovim.</p>
          <div class="hero-actions">
            <a class="button primary" href="#projects">Explore my work <span aria-hidden="true">↘</span></a>
            <a class="text-link" href="/cv.pdf" download="Louis_Nguyen_Software_Engineer.pdf">Download résumé <span aria-hidden="true">↓</span></a>
          </div>
          <div class="hero-caption"><span>8+ years building in production</span><span>Backend · Cloud · Platform</span></div>
        </div>
        <div class="system-art" role="group" aria-label="Architecture diagram connecting APIs, cloud infrastructure, and data around a reliable system core">
          <div class="art-heading"><span>THE ART OF MAKING IT WORK</span><span aria-hidden="true">✳</span></div>
          <svg class="system-orbits" viewBox="0 0 540 500" fill="none" aria-hidden="true">
            <g>
            <ellipse cx="270" cy="250" rx="211" ry="110" transform="rotate(-35 270 250)" />
            <ellipse cx="270" cy="250" rx="211" ry="110" transform="rotate(35 270 250)" />
            <ellipse cx="270" cy="250" rx="110" ry="211" />
            <path d="M270 39V461M54 250H486" stroke-dasharray="3 8" />
            <circle cx="270" cy="39" r="5" class="orbit-point" />
            <circle cx="85" cy="345" r="6" class="orbit-point" />
            <circle cx="454" cy="157" r="6" class="orbit-point" />
            </g>
          </svg>
          <div class="system-core"><span aria-hidden="true">✳</span><strong>Built to<br />hold up.</strong></div>
          <div class="system-node node-api"><span class="node-icon" aria-hidden="true">↗</span><div><small>THE CONNECTION</small><strong>Thoughtful APIs</strong></div></div>
          <div class="system-node node-cloud"><span class="node-icon" aria-hidden="true">⌘</span><div><small>THE FOUNDATION</small><strong>Resilient cloud</strong></div></div>
          <div class="system-node node-data"><span class="node-icon" aria-hidden="true">≋</span><div><small>THE FLOW</small><strong>Data at scale</strong></div></div>
          <div class="art-footer">
            <span>Architecture is a practice.<br />Reliability is the outcome.</span>
            <label class="motion-control"><input type="checkbox" /> Pause motion</label>
          </div>
        </div>
      </section>

      <div class="company-strip" aria-label="Companies I have contributed to">
        <p>Good work.<br /><span>Great teams.</span></p>
        <span>RegAsk</span><span>perx</span><span>OIVAN</span><span>KOMI</span><span>UOB</span>
      </div>

      <section id="projects" class="section">
        <div class="section-heading">
          <div><p class="eyebrow">Selected work</p><h2>Behind the product.<br /><span>Beyond the obvious.</span></h2></div>
          <p>Real platforms. Real constraints.<br />A few places where I’ve made a difference.</p>
        </div>
        <div class="project-grid">
          {projects.map((project, index) => (
            <a class={`project-card project-${index}`} href={project.href} target="_blank" rel="noopener">
              <div class="project-art" aria-hidden="true">
                <span class="project-domain">{['REGULATORY INTELLIGENCE', 'CUSTOMER ENGAGEMENT', 'NATIONAL HOUSING', 'CREATOR COMMERCE', 'BANKING & FINANCE', 'E-COMMERCE'][index]}</span>
                <strong class="project-wordmark">{['RegAsk', 'perx', 'sakani', 'KOMI', 'UOB', 'ProductPine'][index]}</strong>
                <span class="project-art-caption">{['Clarity at scale.', 'Every interaction counts.', 'A place to call home.', 'Creators. Connected.', 'Trust, by design.', 'Commerce, in sync.'][index]}</span>
                <span class="project-open">↗</span>
              </div>
              <div class="project-content">
                <div class="project-title"><h3>{project.name}</h3><span>{project.company}</span></div>
                <p>{project.summary}</p>
                <div class="tags">{project.tags.map((tag) => <span>{tag}</span>)}</div>
              </div>
            </a>
          ))}
        </div>
      </section>

      <section class="impact-band" aria-label="Selected engineering outcomes">
        <p>Less friction.<br /><strong>More impact.</strong></p>
        <div><strong>10×</strong><span>Redis write throughput<br />10K → 100K requests / sec</span></div>
        <div><strong>30%</strong><span>Lower infrastructure cost<br />Kubernetes / Knative at Regask</span></div>
        <div><strong>20×</strong><span>Faster ETL processing<br />5 hours → 15 minutes / GB</span></div>
      </section>

      <section id="experience" class="section experience-section">
        <div class="section-heading"><div><p class="eyebrow">The journey</p><h2>Built through<br /><span>experience.</span></h2></div><p>From shipping full-stack products<br />to shaping the systems underneath.</p></div>
        <div class="timeline">
          {experiences.map((job) => (
            <article class="job">
              <div class="job-meta"><p>{job.period}</p><strong>{job.company}</strong></div>
              <div class="job-body"><h3>{job.role}</h3><p class="stack">{job.stack}</p><ul>{job.bullets.map((bullet) => <li>{bullet}</li>)}</ul></div>
            </article>
          ))}
        </div>
      </section>

      <section id="skills" class="section expertise-section">
        <div class="section-heading"><div><p class="eyebrow">My toolkit</p><h2>Deep in the backend.<br /><span>Fluent across the stack.</span></h2></div><a class="text-link" href="https://www.credly.com/users/nguyen-louis/badges#credly" target="_blank" rel="noopener">View certifications ↗</a></div>
        <div class="skill-grid">{skills.map(([title, value]) => <div class="skill"><h3>{title}</h3><p>{value}</p></div>)}</div>
      </section>

      <section id="contact" class="contact">
        <div><p class="eyebrow"><span class="status-dot"></span> Open to what’s next</p><h2>Good things start<br />with a <span>conversation.</span></h2><p>Have a challenging system, an ambitious team, or an interesting role?<br />I’d love to hear about it.</p><a class="button primary" href="mailto:huynguyennbk@gmail.com">Let’s build something <span aria-hidden="true">↗</span></a></div>
        <span class="contact-art" aria-hidden="true">✳</span>
      </section>
    </main>
    <footer><a class="brand" href="#top">louis nguyen<span class="brand-dot">®</span></a><div class="footer-links">{links.map(link => <a href={link.href} target={link.href.startsWith('http') ? '_blank' : undefined} rel="noopener">{link.label} ↗</a>)}<a href="/cover-letter.pdf" download="Louis_Huy_Nguyen_Cover_Letter.pdf">Cover letter ↓</a></div><span>© {new Date().getFullYear()}</span></footer>
  </div>
</Layout>
